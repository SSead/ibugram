# Copy to .env and adjust. Every value below is the development default, so an empty
# .env still boots against the local PostgreSQL instance.

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USERNAME=sead
# DATABASE_PASSWORD=
DATABASE_NAME=ibugram_dev

# Required in the production environment; the development default is not a secret.
JWT_SECRET=ibugram-development-secret-do-not-use-in-production

ACCESS_TOKEN_LIFETIME=900
REFRESH_TOKEN_LIFETIME=5184000

MEDIA_DIRECTORY=.media
PUBLIC_BASE_URL=http://127.0.0.1:8080
MAX_UPLOAD_BYTES=10485760
THUMBNAIL_MAX_PIXELS=400
JPEG_QUALITY=0.82

APP_VERSION=1.0.0
